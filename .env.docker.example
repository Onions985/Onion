# Copy to .env on the deployment server. Use URL-safe random passwords (hex is convenient).
MYSQL_PASSWORD=replace-with-a-random-hex-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SITE_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
PORT=3000
SEED_EXAMPLES=false
