{
  "name": "onion-personal-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "test": "node --import tsx --test tests/core.test.ts tests/moment-unit.test.ts tests/discovery.test.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/check-integration.mjs",
    "dev:db": "node scripts/dev-mysql.mjs",
    "dev:db:stop": "node scripts/stop-dev-mysql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "busboy": "1.6.0",
    "dompurify": "^3.4.15",
    "file-type": "22.1.1",
    "h3": "^1.15.4",
    "highlight.js": "^11.11.1",
    "image-size": "2.0.4",
    "markdown-it": "^14.3.2",
    "md-editor-v3": "7.0.0",
    "mysql2": "3.24.4",
    "sanitize-html": "2.17.7",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/sanitize-html": "^2.16.0",
    "nuxt": "4.5.2",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.2.6"
  }
}
