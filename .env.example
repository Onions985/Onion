DATABASE_URL=mysql://onion:change_this_database_password@127.0.0.1:3306/onion
UPLOAD_DIR=./data/uploads
SITE_URL=http://localhost:3000
COOKIE_SECURE=false
# Enable only behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
ADMIN_EMAIL=admin@onion.local
ADMIN_PASSWORD=replace_with_a_long_unique_password
